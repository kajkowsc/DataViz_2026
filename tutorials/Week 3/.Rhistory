# library(corrgram)
corrgram(weather_cor)
# library(ggcorrplot)
ggcorrplot(cor(weather_cor))
# run our "simple" regression w/ max temp as outcome
model_simple <- lm(maxtp ~ rain, data = IRE_weather)
ggplot(IRE_weather,
aes(x = rain, y = maxtp)) +
