means_natparty <- combined_data %>%
group_by(`National Party`) %>%
summarise(
n_yes = sum(vote == "Yes", na.rm = TRUE),
n_no = sum(vote == "No", na.rm = TRUE),
n_abstain = sum(vote == "Abstain", na.rm = TRUE),
mean_yes_rate = n_yes / (n_yes + n_no + n_abstain),
mean_abstain_rate = n_abstain / (n_yes + n_no + n_abstain),
.groups = "drop"
)
View(means_natparty)
ggplot(means_natparty, aes( x = reorder(`National Party`, mean_yes_rate), y = mean_yes_rate, fill = `National Party`)) +
geom_col() +
theme_minimal()
ggplot(means_natparty, aes(x = reorder(`National Party`, mean_yes_rate),
y = mean_yes_rate,
fill = `National Party`)) +
geom_col(show.legend = FALSE) +  # hide legend if bars are labeled
coord_flip() +                   # horizontal bars for readability
scale_y_continuous(labels = scales::percent_format(accuracy = 1), limits = c(0,1)) +
labs(
title = "Proportion Voting Yes by National Party (EP1)",
x = "National Party",
y = "Proportion voting Yes"
) +
theme_minimal(base_size = 14) +
theme(
axis.text.x = element_text(angle = 0),
axis.text.y = element_text(size = 10),
plot.title = element_text(face = "bold", hjust = 0.5)
)
