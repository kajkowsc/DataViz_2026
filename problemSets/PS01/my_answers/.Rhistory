#Note that pivoting functions come 'tidyr' package
tidyr::pivot_longer(
cols = c("1999", "2000"),
names_to = "year",
values_to = "cases"
)
tb2
# A tibble: 4 × 3
#country     year  cases
#<chr>       <chr> <dbl>
#Afghanistan 1999    745
#Afghanistan 2000  37737
#Brazil      1999   2666
#Brazil      2000  80488
tb2 <- tb2 %>%
tidyr::pivot_wider(names_from = "year", values_from = "cases")
tb2
