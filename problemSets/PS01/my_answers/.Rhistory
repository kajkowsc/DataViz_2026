#Q2 a
assigned_coef <- 0.042
assigned_se <- 0.016
adjacent_coef <- 0.042
adjacent_se <- 0.013
n <- 131
k <- 2
degfree <- n - k - 1
t_value_1 <- assigned_coef/assigned_se
#2.625
p_value_1 <- 2 * (1-pt(abs(t_value_1), degfree))
#0.00972002
#Q2 b
t_value_2 <- adjacent_coef/adjacent_se
#3.230769
p_value_2 <- 2 * (1-pt(abs(t_value_2), degfree))
#0.00156946
#Q2 d
R2 <- 0.094
f_stat <- (R2/k) / ((1- R2)/(n-k-1))
p_f_test <- pf(f_stat, df1 = k, df2 = n-k-1, lower.tail = FALSE)
#0.000368501148888212
