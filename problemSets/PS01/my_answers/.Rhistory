n_abstain = sum(vote == "Abstain", na.rm = TRUE),
mean_yes_rate = n_yes / (n_yes + n_no + n_abstain),
mean_abstain_rate = n_abstain / (n_yes + n_no + n_abstain),
mean_nomd1 = mean(NOM_D1, na.rm = TRUE),
mean_nom2 = mean(NOM_D2, na.rm = TRUE),
.groups = "drop"
)
ggplot(means_EPG, aes(x = mean_yes_rate, color = EPG)) +
geom_boxplot() +
ggplot(means_EPG, aes(x = EPG, y = yes_rate)) +
geom_boxplot()
ggplot(means_EPG, aes(x = EPG, y = yes_rate)) +
geom_boxplot() +
coord_cartesian(ylim = c(0, 1))
ggplot(means_EPG, aes(x = EPG, y = mean_yes_rate)) +
geom_boxplot()
ggplot(means_EPG, aes(x = EPG, y = mean_yes_rate, color = EPG)) +
geom_boxplot()
ggplot(means_EPG, aes(x = EPG, y = mean_yes_rate, color = EPG)) +
geom_boxplot() +
labs(
x = "EP Group",
y = "Proportion voting Yes",
title = "Boxplot of the proportion voting Yes by EP group"
) +
theme_minimal()
ggplot(means_EPG, aes(x = EPG, y = mean_yes_rate, color = EPG)) +
geom_boxplot() +
labs(
x = \n"EP Group",
ggplot(means_EPG, aes(x = EPG, y = mean_yes_rate, color = EPG)) +
geom_boxplot() +
labs(
x = "\nEP Group",
y = "Proportion voting Yes",
title = "Boxplot of the proportion voting Yes by EP group"
) +
theme_minimal()
ggplot(means_EPG, aes(x = EPG, y = mean_yes_rate, color = EPG)) +
