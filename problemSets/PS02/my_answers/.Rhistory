sum_class_rows <- rowSums(class_bribe)
sum_bribe_columns <- colSums(class_bribe)
total_sum <- sum(class_bribe)
expected_values_class_bribe <- matrix(nrow = nrow(class_bribe), ncol = ncol(class_bribe))
expected_values_class_bribe <- matrix(nrow = nrow(class_bribe), ncol = ncol(class_bribe))
for (i in 1:nrow(class_bribe)) {
